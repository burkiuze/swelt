# Clerk (Google sign-in) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# RunPod public endpoints (image / video models)
RUNPOD_API_KEY=rpa_...
# Optional JSON map to override endpoint IDs: {"flux-1-schnell":"black-forest-labs-flux-1-schnell"}
RUNPOD_ENDPOINT_OVERRIDES=

# Higgsfield (Kling 4.0, Genjutsu Light, Marketing Studio Image). Format: <key id>:<key secret>
HIGGSFIELD_API_KEY=
# Optional: pin slugs instead of matching the live /models list, e.g. {"kwaivgi/kling-4.0":"<slug>"}
HIGGSFIELD_SLUG_OVERRIDES=

# OpenRouter (agent LLMs)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: override OpenRouter model slugs
OPENROUTER_MODEL_OPUS=anthropic/claude-opus-5.5
OPENROUTER_MODEL_SOL=openai/gpt-6.1-sol

# Supabase (generations, credits, API keys). Server-only secret checked by the swelt_* RPCs.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=...
SWELT_DB_SECRET=...

# Credits
FREE_CREDITS=1.00
ADMIN_EMAILS=you@example.com
# Token for /api/admin/* diagnostics
ADMIN_TOKEN=

# Optional: Vercel Blob for uploads + persisting outputs
BLOB_READ_WRITE_TOKEN=
